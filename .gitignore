# Ignorar banco local e ambientes virtuais
# O backend roda com CWD na raiz do projeto (ver .claude/launch.json), então o
# SQLite de desenvolvimento nasce AQUI, não dentro de backend/ — sem estas duas
# linhas o banco local (com os dados da fazenda) entrava no commit por acidente.
/fazenda.db
/*.db
backend/fazenda.db
backend/*.db
backend/.env

# Configuração local do Claude Code (pessoal, específica da máquina)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
.eggs/
dist/
build/

# Node
frontend/node_modules/
frontend/.next/
frontend/.env.local

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Logs e temporários
*.log
